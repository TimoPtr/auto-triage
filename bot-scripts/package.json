{
  "name": "auto-triage-scripts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Knowledge index builder and retrieval for the Home Assistant triage bot. TypeScript run natively by Node 26 (type stripping); installed with npm ci --ignore-scripts --omit=dev by the composite actions.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --test",
    "build-index": "node src/cli/build.ts",
    "query": "node src/cli/query.ts",
    "mine-cases": "node src/cli/mine-cases.ts",
    "run-eval": "node src/cli/run-eval.ts",
    "compare-eval": "node src/cli/compare-eval.ts",
    "bake-off": "node src/cli/bake-off.ts",
    "prepare-triage": "node src/cli/prepare-triage.ts",
    "render-verdict": "node src/cli/render-verdict.ts",
    "collect-feedback": "node src/cli/collect-feedback.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "ajv": "^8.17.1",
    "sqlite-vec": "0.1.9",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
